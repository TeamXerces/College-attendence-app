<%@ taglib prefix="c" uri="jakarta.tags.core" %>
<c:set var="ctx" value="${pageContext.request.contextPath}" />
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8"><meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title><c:out value="${pageTitle}"/> · CampusFlow</title>
    <link rel="stylesheet" href="${ctx}/assets/app.css">
</head>
<body class="app-body">
<div class="app-shell">
    <aside class="sidebar" id="sidebar">
        <a class="brand-lockup sidebar-brand" href="${ctx}/app/dashboard"><span class="brand-mark">C</span><span>CampusFlow</span></a>
        <div class="sidebar-label">WORKSPACE</div>
        <nav class="side-nav">
            <a class="nav-link ${activePage eq 'dashboard' ? 'active' : ''}" href="${ctx}/app/dashboard"><span class="nav-icon">◫</span>Overview</a>
            <c:if test="${sessionScope.role eq 'ADMIN'}">
                <div class="sidebar-label nav-section-label">CAMPUS MANAGEMENT</div>
                <a class="nav-link ${activePage eq 'students' ? 'active' : ''}" href="${ctx}/app/students"><span class="nav-icon">♙</span>Students</a>
                <a class="nav-link ${activePage eq 'faculty' ? 'active' : ''}" href="${ctx}/app/faculty"><span class="nav-icon">♧</span>Faculty</a>
                <a class="nav-link ${activePage eq 'courses' ? 'active' : ''}" href="${ctx}/app/courses"><span class="nav-icon">▤</span>Courses</a>
            </c:if>
            <c:if test="${sessionScope.role ne 'STUDENT'}">
                <div class="sidebar-label nav-section-label">ATTENDANCE</div>
                <a class="nav-link ${activePage eq 'attendance' ? 'active' : ''}" href="${ctx}/app/attendance"><span class="nav-icon">☑</span>Mark attendance</a>
                <a class="nav-link ${activePage eq 'reports' ? 'active' : ''}" href="${ctx}/app/reports"><span class="nav-icon">▥</span>Reports</a>
            </c:if>
            <c:if test="${sessionScope.role eq 'STUDENT'}">
                <div class="sidebar-label nav-section-label">MY ACADEMICS</div>
                <a class="nav-link ${activePage eq 'my-attendance' ? 'active' : ''}" href="${ctx}/app/my-attendance"><span class="nav-icon">▦</span>My attendance</a>
            </c:if>
        </nav>
        <div class="sidebar-bottom">
            <div class="help-card"><div class="help-icon">✦</div><strong>Stay in the loop</strong><p>Keep your attendance records accurate and up to date.</p></div>
            <div class="sidebar-user"><span class="avatar avatar-sidebar">CF</span><span class="sidebar-user-meta"><b><c:out value="${sessionScope.userName}"/></b><small><c:out value="${sessionScope.role}"/></small></span><form method="post" action="${ctx}/logout" class="logout-form"><input type="hidden" name="_csrf" value="${sessionScope.csrfToken}"><button class="logout-icon" type="submit" title="Sign out" aria-label="Sign out">↗</button></form></div>
        </div>
    </aside>
    <main class="main-area">
        <header class="topbar">
            <button class="mobile-menu" type="button" data-menu-toggle aria-label="Toggle navigation">☰</button>
            <div class="breadcrumb"><span>Workspace</span><b>/</b><strong><c:out value="${pageTitle}"/></strong></div>
            <div class="topbar-right"><span class="today-label">ACADEMIC WORKSPACE</span><span class="avatar avatar-top"><c:out value="${sessionScope.userName}"/></span></div>
        </header>
        <div class="page-content">
            <c:if test="${not empty sessionScope.flashMessage}">
                <div class="alert ${sessionScope.flashType eq 'success' ? 'alert-success' : 'alert-error'}" data-auto-dismiss><span class="alert-dot"></span><c:out value="${sessionScope.flashMessage}"/></div>
                <c:remove var="flashMessage" scope="session"/><c:remove var="flashType" scope="session"/>
            </c:if>
