<%@ page contentType="text/html;charset=UTF-8" language="java" %>
<%@ include file="_header.jspf" %>
<section class="page-heading compact-heading"><div><span class="eyebrow">INSIGHTS & ANALYTICS</span><h1>Attendance reports</h1><p>Review student attendance by course, identify low-attendance cases and export your data.</p></div><a class="btn btn-secondary" href="${ctx}/app/reports?format=csv&courseId=${selectedCourse}&from=${from}&to=${to}">↓ Export CSV</a></section>
<section class="panel report-filter-panel"><form method="get" action="${ctx}/app/reports" class="report-filter-form"><div class="field"><label>COURSE</label><select name="courseId"><option value="0">All accessible courses</option><c:forEach items="${courses}" var="course"><option value="${course.id}" ${selectedCourse eq course.id ? 'selected' : ''}><c:out value="${course.course_code}"/> · <c:out value="${course.course_name}"/></option></c:forEach></select></div><div class="field"><label>FROM DATE</label><input type="date" name="from" value="<c:out value='${from}'/>"></div><div class="field"><label>TO DATE</label><input type="date" name="to" value="<c:out value='${to}'/>"></div><button class="btn btn-primary" type="submit">Apply filters <span>→</span></button></form></section>
<section class="report-kpis"><article class="report-kpi"><span class="report-kpi-icon">▥</span><div><strong><c:out value="${rowCount}"/></strong><small>Student-course records</small></div></article><article class="report-kpi"><span class="report-kpi-icon report-risk">!</span><div><strong><c:out value="${atRisk}"/></strong><small>Below 75% attendance</small></div></article><article class="report-kpi"><span class="report-kpi-icon report-check">✓</span><div><strong>75%</strong><small>Attendance target</small></div></article></section>
<section class="panel section-panel directory-panel"><div class="panel-heading"><div><span class="eyebrow">DETAILED REPORT</span><h3>Student attendance overview</h3></div><span class="pill pill-soft">Current filters</span></div><div class="table-wrap"><table><thead><tr><th>STUDENT</th><th>COURSE</th><th>ATTENDED</th><th>SESSIONS</th><th>ATTENDANCE</th><th>STATUS</th></tr></thead><tbody>
<c:forEach items="${rows}" var="row"><tr><td><div class="person-cell"><span class="person-avatar"><c:out value="${row.full_name.substring(0,1)}"/></span><span><b><c:out value="${row.full_name}"/></b><small class="cell-sub"><c:out value="${row.roll_no}"/></small></span></div></td><td><b><c:out value="${row.course_code}"/></b><small class="cell-sub"><c:out value="${row.course_name}"/></small></td><td><c:out value="${row.attended}"/></td><td><c:out value="${row.total_sessions}"/></td><td><div class="report-progress-cell"><b class="${row.percentage lt 75 ? 'text-warning' : 'text-positive'}"><c:out value="${row.percentage}"/>%</b><div class="progress-track"><div class="progress-fill ${row.percentage lt 75 ? 'progress-warning' : ''}" style="width:${row.percentage}%"></div></div></div></td><td><c:choose><c:when test="${row.percentage lt 75}"><span class="status-pill status-ABSENT">At risk</span></c:when><c:otherwise><span class="status-pill status-PRESENT">On track</span></c:otherwise></c:choose></td></tr></c:forEach>
<c:if test="${empty rows}"><tr><td colspan="6" class="empty-cell">No attendance records match these filters.</td></tr></c:if>
</tbody></table></div><div class="table-footnote">Attendance percentage = (Present + Late) ÷ counted sessions. Excused records are excluded from the denominator.</div></section>
<%@ include file="_footer.jspf" %>
